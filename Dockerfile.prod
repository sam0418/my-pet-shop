# 前端 Dockerfile - 生產版本
# 使用多階段構建：開發階段 -> 最終運行階段

# ===== 階段1: 開發環境 =====
FROM node:18-alpine AS development

WORKDIR /app

# 複製 package 檔案
COPY package*.json ./

# 安裝依賴（包括開發依賴）
RUN npm ci --legacy-peer-deps || npm ci

# 複製應用代碼
COPY . .

# ===== 階段2: 生產環境 =====
FROM nginx:1.25-alpine

# 安裝 curl 用於健康檢查
RUN apk add --no-cache curl

# 複製優化後的 nginx 配置
COPY nginx.conf /etc/nginx/nginx.conf

# 複製靜態檔案到 nginx 根目錄
COPY index.html /usr/share/nginx/html/
COPY js/ /usr/share/nginx/html/js/
COPY phone/ /usr/share/nginx/html/phone/

# 創建 404 錯誤頁面（SPA 路由用）
RUN echo '<!DOCTYPE html><html><head><meta charset="utf-8"><title>Page Not Found</title></head><body><h1>404 - Page Not Found</h1></body></html>' > /usr/share/nginx/html/404.html

# 創建 50x 錯誤頁面
RUN echo '<!DOCTYPE html><html><head><meta charset="utf-8"><title>Server Error</title></head><body><h1>5xx - Server Error</h1></body></html>' > /usr/share/nginx/html/50x.html

# 暴露端口
EXPOSE 3000

# 健康檢查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3000/healthz || exit 1

# 啟動 nginx（前台模式）
CMD ["nginx", "-g", "daemon off;"]
